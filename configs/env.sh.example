# Sourced by every SLURM script after `cd "$DG_ROOT"`. Copy to configs/env.sh and edit.
# Activate the Python environment that has requirements.txt installed, e.g.:
#   module load Anaconda3
#   conda activate direction-gain
export MODEL_ROOT="${MODEL_ROOT:-$DG_ROOT/models}"   # local model directories / HF cache
export PYTHON="${PYTHON:-python}"
# Optional extra sbatch arguments used by the job controllers (account, qos, ...):
# export DG_SBATCH_ARGS="--account=YOUR_ACCOUNT"
# export DG_GPU_PARTITIONS="gpu"
